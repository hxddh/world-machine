        {".remembered": [
          {"said": [
            "keeper_rested",
            "{keeper} took a day off while {explorer} covered",
            "Thank you. I needed that.",
            {"bond": [1, -2]}
          ]},
          "Still feel rested."
        ]}
      ]},
      {"no": [
        "keep_going",
        "Keep going",
