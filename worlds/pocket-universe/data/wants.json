        {"said": [
          "keeper_kept_going",
          "{keeper} kept going without a break",
          "Right. Back to it.",
          {"bond": [0, 2]}
        ]}
      ]}
    ],
    {"said": [
      "keeper_worn_out",
      "{keeper} wore out",
      "I can't keep my eyes open.",
      {"bond": [0, 1]}
    ]}
  ]},
  {"spec": [
    "explorer_teach",
    {"want": ["@SLOT_E", [{"up": ["trust"]}, {"down": ["tension"]}]]},
