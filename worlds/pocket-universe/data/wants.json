            "{explorer} brought {keeper} {spare}",
            "You went all that way for this?",
            {"bond": [2, 0]}
          ]},
          "Slept like a stone since you brought that."
        ]}
      ]},
      {"no": [
        "make_do",
        "Make do",
        "Nobody goes anywhere. {keeper} lies awake.",
        {"said": [
          "spare_refused",
          "{keeper} was told to make do",
          "Fine. I'll make do.",
          {"bond": [-1, 2]}
        ]}
      ]}
    ],
    {"said": [
      "spare_went_without",
      "{keeper} went without {spare}",
      "Nobody listens.",
      {"bond": [-1, 1]}
    ]}
  ]},
  {"spec": [
