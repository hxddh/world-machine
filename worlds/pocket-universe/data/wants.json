    {"want": ["@SLOT_E", [{"up": ["tension"]}, {"down": ["trust"]}]]},
    {"()": [
      "{explorer} wants to go past the edge of the map",
      "Just one trip past the edge of the map."
    ]},
    [
      {"yes": [
