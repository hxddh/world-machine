[
  {"spec": [
    "school_roof",
    {"want": ["@EMMA"]},
    {"()": ["Emma's school roof is leaking", "The roof's dripping on the desks again."]},
    [
      {"yes": [
        "mend",
        "Pay Evan to mend it",
        "Noah puts in 60: 25 to Evan for the work, the rest for mainland slate.",
        [{"has": ["@NOAH", 60]}],
        {".remembered": [
          {"said": [
            "school_roof_mended",
            "Evan mended the school roof",
            "Dry desks at last!",
            {".chain": [
              [{"pay": ["@NOAH", "@EVAN", 25]}, {"spend": ["@NOAH", 35]}],
              [{"mood": [1]}]
            ]}
          ]},
          "The children can hear themselves think now."
        ]}
      ]},
      {"no": [
        "bucket",
        "A bucket will do",
        "Nothing spent. Emma won't forget it.",
        {"said": [
          "school_roof_left",
          "Emma was told a bucket would do",
          "A bucket. Wonderful.",
          [{"mood": [-1]}]
        ]}
      ]}
    ],
    {"said": [
      "school_roof_fell_in",
      "Part of the school roof came in",
      "Half the ceiling's on the floor!",
      {".chain": [{"spend": ["@NOAH", 80]}, [{"mood": [-1]}]]}
    ]}
  ]},
  {"spec": [
    "music_night",
    {"want": ["@LEO"]},
    {"()": ["Leo wants to put on a music night", "A fiddler and a full pub. What do you say?"]},
    [
      {"yes": [
        "hold",
        "Put it on",
        "Leo spends 40 on a fiddler from the mainland. The whole harbour comes.",
        [{"has": ["@LEO", 40]}],
        {".remembered": [
          {"said": [
            "music_night_held",
            "The Anchor Pub had a music night",
            "Listen to them sing!",
            {".chain": [{"spend": ["@LEO", 40]}, [{"mood": [2]}]]}
          ]},
          "My feet still ache from dancing."
        ]}
      ]},
      {"no": [
        "quiet",
        "Keep it quiet",
        "Nothing spent, and nothing to remember.",
        {"said": [
          "music_night_called_off",
          "Leo called off his music night",
          "Another quiet night, then.",
          []
        ]}
      ]}
    ],
    {"said": [
      "music_night_forgotten",
      "Leo's music night never happened",
      "Nobody seemed to care.",
      [{"mood": [-1]}]
    ]}
  ]},
  {"spec": [
    "new_oven",
    {".requires": [
      {"want": ["@MARA"]},
      [{"Condition::Is": ["@BAKERY", "@OPERATING_STATUS", "open"]}]
    ]},
    {"()": ["Mara's oven is failing", "The old oven burns every other loaf."]},
    [
      {"yes": [
        "buy",
        "Buy a new oven",
        "80 of Mara's savings go to the mainland for a new oven.",
        [{"has": ["@MARA", 80]}],
        {".remembered": [
          {"said": [
            "oven_bought",
            "Mara's new oven arrived",
            "Listen to that oven roar!",
            {".chain": [{"spend": ["@MARA", 80]}, [{"mood": [1]}]]}
          ]},
          "Not a burnt loaf all week."
        ]}
      ]},
      {"no": [
        "patch",
        "Patch the old one",
        "Evan patches it for 10. It won't last.",
        {"said": [
          "oven_patched",
          "Mara patched up the old oven",
          "Held together with wire and hope.",
          {"pay": ["@MARA", "@EVAN", 10]}
        ]}
      ]}
    ],
    {"said": [
      "oven_failed",
      "Mara's oven gave out",
      "A whole batch, ruined.",
      {".chain": [{"spend": ["@MARA", 30]}, [{"mood": [-1]}]]}
    ]}
  ]},
  {"spec": [
    "new_nets",
    {".requires": [
      {"want": ["@JONAS"]},
